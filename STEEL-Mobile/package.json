{
  "name": "steel-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "STEAL Fitness Mobile App — iOS + Android with PocketBase",
  "scripts": {
    "ios": "cd ios-app && xcodebuild -scheme STEAL -destination 'platform=iOS Simulator,name=iPhone 15' -derivedDataPath build",
    "ios:sim": "open ios-app/build/Build/Products/Debug-iphonesimulator/STEAL.app",
    "android": "cd android-app && ./gradlew installDebug",
    "android:emulator": "cd android-app && ./gradlew installDebug && adb shell am start -n com.steel/.MainActivity",
    "shared:build": "cd shared && ./gradlew build",
    "shared:iosX64": "cd shared && ./gradlew iosX64",
    "shared:iosArm64": "cd shared && ./gradlew iosArm64",
    "shared:android": "cd shared && ./gradlew assembleDebug",
    "shared:assemble": "cd shared && ./gradlew assemble",
    "clean": "rm -rf ios-app/build android-app/.gradle shared/build",
    "clean:all": "pnpm clean && rm -rf node_modules",
    "lint:ios": "cd ios-app && swiftlint",
    "lint:android": "cd android-app && ./gradlew lint",
    "test:shared": "cd shared && ./gradlew jvmTest",
    "test:ios": "cd ios-app && xcodebuild test -scheme STEAL",
    "test:android": "cd android-app && ./gradlew test"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "fitness",
    "workout",
    "powerlifting",
    "ios",
    "android",
    "kotlin-multiplatform",
    "swiftui",
    "jetpack-compose"
  ],
  "author": "Steel Fitness",
  "license": "UNLICENSED"
}